# =========================================================
# NEXA Backend — Environment Configuration Template
# Copy to .env and fill in real values. NEVER commit .env.
# =========================================================

# --- App ---
NODE_ENV=development
PORT=3000
API_PREFIX=api/v1
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:19006

# --- Database (PostgreSQL) ---
DATABASE_URL=postgresql://nexa:nexa_dev_password@localhost:5432/nexa_dev?schema=public

# --- Initial admin bootstrap ---
# Used only by `npm run prisma:seed` to create the first SUPER_ADMIN account.
# Leave unset to skip seeding.
SEED_SUPER_ADMIN_PHONE=

# --- Auth / JWT ---
# Generate strong random secrets, e.g.: openssl rand -base64 48
JWT_ACCESS_SECRET=replace-with-a-strong-random-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=replace-with-a-different-strong-random-secret
JWT_REFRESH_EXPIRES_IN=30d

# --- OTP ---
# In development, OTP_PROVIDER=console logs OTPs to the server console instead
# of sending real SMS. Set OTP_PROVIDER=sms and configure a real provider
# (e.g. Termii, Africa's Talking, Twilio) before production use.
OTP_PROVIDER=console
OTP_CODE_LENGTH=6
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60

# --- SMS provider (required only when OTP_PROVIDER=sms) ---
SMS_PROVIDER_API_KEY=
SMS_PROVIDER_SENDER_ID=NEXA

# --- Identity Verification (NIN) ---
# IDENTITY_PROVIDER=mock uses a local, clearly-labeled fake provider for
# development/testing ONLY. It performs NO real NIN lookups.
# Before production, this must be switched to an authorized Nigerian identity
# verification provider (e.g. a licensed NIMC-connected vendor) and the
# corresponding credentials below must be supplied.
IDENTITY_PROVIDER=mock
IDENTITY_PROVIDER_BASE_URL=
IDENTITY_PROVIDER_API_KEY=
IDENTITY_PROVIDER_CLIENT_ID=
IDENTITY_PROVIDER_WEBHOOK_SECRET=

# --- Encryption for sensitive stored fields ---
# 32-byte (base64) key for AES-256-GCM field-level encryption.
# Generate with: openssl rand -base64 32
FIELD_ENCRYPTION_KEY=replace-with-32-byte-base64-key

# --- Rate limiting ---
THROTTLE_TTL_SECONDS=60
THROTTLE_LIMIT=100

# --- File / document storage ---
# STORAGE_PROVIDER=local is for development only. Production should use
# private, access-controlled object storage (e.g. S3-compatible bucket).
STORAGE_PROVIDER=local
STORAGE_LOCAL_PATH=./uploads
STORAGE_BUCKET_NAME=
STORAGE_REGION=
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=

# --- Payments (Paystack) — configured in a later phase ---
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
PAYSTACK_WEBHOOK_SECRET=

# --- Notifications (Firebase Cloud Messaging) ---
# From a Firebase service account JSON (Project Settings > Service accounts
# > Generate new private key). If any of these are unset, push notifications
# are skipped (logged only) — the in-app notification inbox still works.
FCM_PROJECT_ID=
FCM_CLIENT_EMAIL=
# Paste the private_key value from the JSON. Literal \n sequences are fine —
# they're normalized to real newlines automatically.
FCM_PRIVATE_KEY=

# --- Routing / maps (distance, ETA, polylines) ---
# ROUTE_PROVIDER=mock returns a straight-line distance/ETA estimate — fine
# for development, but NEVER for production (blocked by env validation):
# straight-line distance understates real driving distance and would
# mis-price every fixed-price fare quote.
ROUTE_PROVIDER=mock
MAPBOX_ACCESS_TOKEN=
